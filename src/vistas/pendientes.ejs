<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= titulo %></title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; background: #f6f7f9; color: #222; }
    header { background: #1f2937; color: #fff; padding: 12px 16px; }
    main { max-width: 900px; margin: 0 auto; padding: 16px; }
    .card { background: #fff; border: 1px solid #ddd; border-radius: 8px; padding: 16px; margin-bottom: 16px; }
    form { display: flex; gap: 12px; flex-wrap: wrap; align-items: end; }
    label { display: block; font-weight: 600; margin-bottom: 4px; }
    select, button { padding: 8px 10px; font-size: 14px; }
    .warn { color: #92400e; }
    ul { margin-top: 8px; }
    a { color: #2563eb; }
  </style>
</head>
<body>
  <header><strong>SnapSip</strong> — HU-06: Consultar piezas pendientes</header>
  <main>
    <div class="card">
      <h2>Consultar piezas pendientes</h2>
      <form method="GET" action="/pendientes">
        <div>
          <label for="proyectoId">Proyecto</label>
          <select id="proyectoId" name="proyectoId" required>
            <option value="">-- Seleccione un proyecto --</option>
            <% proyectos.forEach(function(proyecto) { %>
              <option value="<%= proyecto.id %>" <%= proyectoId === proyecto.id ? 'selected' : '' %>><%= proyecto.codigo %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label for="parteCasaId">Parte de la casa</label>
          <select id="parteCasaId" name="parteCasaId" required>
            <option value="">-- Seleccione una parte --</option>
            <% partes.forEach(function(parte) { %>
              <option value="<%= parte.id %>" <%= parteCasaId === parte.id ? 'selected' : '' %>><%= parte.nombre %></option>
            <% }); %>
          </select>
        </div>
        <button type="submit">Consultar</button>
      </form>
      <p><a href="/">Volver al inicio</a></p>
    </div>

    <% if (!haySeleccion) { %>
      <div class="card">
        <p class="warn">Seleccione un Proyecto y una Parte de la casa para consultar.</p>
      </div>
    <% } else { %>
      <div class="card">
        <h3>Piezas pendientes de <%= parteElegida.nombre %></h3>
        <% if (piezas.length === 0) { %>
          <p class="warn">0 pendientes para <%= parteElegida.nombre %></p>
        <% } else { %>
          <ul>
            <% piezas.forEach(function(pieza) { %>
              <li><strong><%= pieza.codigo %></strong> — <%= pieza.estado %>, sin torre asignada</li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    <% } %>
  </main>
</body>
</html>
