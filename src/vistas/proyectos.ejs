<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= titulo %></title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; background: #f6f7f9; color: #222; }
    header { background: #1f2937; color: #fff; padding: 12px 16px; }
    main { max-width: 900px; margin: 0 auto; padding: 16px; }
    .card { background: #fff; border: 1px solid #ddd; border-radius: 8px; padding: 16px; margin-bottom: 16px; }
    table { width: 100%; border-collapse: collapse; margin-top: 8px; }
    th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
    th { background: #f3f4f6; }
    a { color: #2563eb; }
  </style>
</head>
<body>
  <header><strong>SnapSip</strong> — HU-02 / HU-03: Proyectos</header>
  <main>
    <div class="card">
      <h1><%= titulo %></h1>
      <p>Rol actual: <strong><%= rolActual %></strong>. <a href="/proyectos/nuevo">Crear nuevo proyecto</a> · <a href="/">Inicio</a></p>
      <% if (proyectos.length === 0) { %>
        <p>No hay proyectos registrados.</p>
      <% } else { %>
        <table>
          <thead>
            <tr><th>Código</th><th>Cliente</th><th>Metraje</th><th>Estado</th><th>Partes</th><th>Piezas</th><th>Inyección de piezas</th></tr>
          </thead>
          <tbody>
            <% proyectos.forEach(function(p) { %>
              <tr>
                <td><%= p.codigo %></td>
                <td><%= p.cliente %></td>
                <td><%= p.metraje %></td>
                <td><%= p.estado %></td>
                <td><%= p.partes %></td>
                <td><%= p.piezas %></td>
                <td>
                  <% if (rolActual === 'Encargado de Despacho' && p.estado === 'Sin piezas cargadas' && p.partes === 0 && p.piezas === 0) { %>
                    <form method="post" action="/proyectos/<%= encodeURIComponent(p.codigo) %>/inyectar-piezas">
                      <button type="submit">Inyectar piezas desde plano/archivo</button>
                    </form>
                    <small>Plano/archivo simulado (demo).</small>
                  <% } else { %>
                    <small>Sin acción disponible.</small>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</body>
</html>
