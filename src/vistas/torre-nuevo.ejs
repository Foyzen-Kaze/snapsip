<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= titulo %></title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; background: #f6f7f9; color: #222; }
    header { background: #1f2937; color: #fff; padding: 12px 16px; }
    main { max-width: 900px; margin: 0 auto; padding: 16px; }
    .card { background: #fff; border: 1px solid #ddd; border-radius: 8px; padding: 16px; margin-bottom: 16px; }
    form { display: flex; gap: 12px; flex-wrap: wrap; align-items: end; }
    label { display: block; font-weight: 600; margin-bottom: 4px; }
    select, button { padding: 8px 10px; font-size: 14px; }
    .error { color: #b91c1c; }
    a { color: #2563eb; }
  </style>
</head>
<body>
  <header><strong>SnapSip</strong> — HU-04: Crear torre</header>
  <main>
    <div class="card">
      <h2>Crear torre</h2>
      <p>Registre una torre para un proyecto con piezas cargadas y una parte de la casa. Queda en estado <strong>Abierta</strong> y sin piezas asignadas.</p>
      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>
      <form method="POST" action="/torres">
        <div>
          <label for="proyectoId">Proyecto</label>
          <select id="proyectoId" name="proyectoId" required>
            <option value="">-- Seleccione un proyecto --</option>
            <% proyectos.forEach(function(proyecto) { %>
              <option value="<%= proyecto.id %>" <%= proyectoId === proyecto.id ? 'selected' : '' %>><%= proyecto.cliente %> (<%= proyecto.codigo %>)</option>
            <% }); %>
          </select>
        </div>
        <div>
          <label for="parteCasaId">Parte de la casa</label>
          <select id="parteCasaId" name="parteCasaId" required>
            <option value="">-- Seleccione una parte --</option>
            <% partes.forEach(function(parte) { %>
              <option value="<%= parte.id %>" <%= parteCasaId === parte.id ? 'selected' : '' %>><%= parte.nombre %></option>
            <% }); %>
          </select>
        </div>
        <button type="submit">Crear torre</button>
      </form>
      <p><a href="/">Volver al inicio</a></p>
    </div>
  </main>

  <!-- HU-04, CU-04: llenar el selector de Parte al elegir Proyecto (patrón de HU-06). -->
  <script>
    (function () {
      var proyecto = document.getElementById('proyectoId');
      var parte = document.getElementById('parteCasaId');
      if (!proyecto || !parte) return;
      proyecto.addEventListener('change', function () {
        parte.value = '';
        proyecto.form.submit();
      });
    })();
  </script>
</body>
</html>
