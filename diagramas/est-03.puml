@startuml est-03
hide empty description
skinparam dpi 150
skinparam shadowing false
skinparam state {
    BackgroundColor #F8F9FA
    BorderColor #343A40
    ArrowColor #495057
    StartColor #343A40
    EndColor #343A40
}

title EST-03 — Ciclo de vida de GuiaDespacho

[*] --> Vigente : generar guía de despacho\n[piezas del alcance Listo y torres\nCerradas]\n/ emitir guía en PDF
Vigente --> Invalidada : desasignar pieza\n[pieza incluida en la guía]\n/ invalidar guía (RD-01)
Vigente --> Invalidada : asignar pieza a torre\n[reasignación de pieza incluida]\n/ invalidar guía (RD-01)
Vigente --> Invalidada : reabrir torre\n[torre incluida en la guía]\n/ invalidar guía (RD-01)
Vigente --> Enviada : registrar envío\n[evidencia del camión adjunta]\n/ registrar usuario, fecha y hora; piezas\npasan a Enviado
Invalidada --> [*]
Enviada --> [*]

@enduml
