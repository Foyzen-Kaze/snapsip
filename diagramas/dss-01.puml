@startuml dss-01
title DSS-01 — Asignar pieza a torre con evidencia
hide footbox
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam maxMessageSize 300
skinparam sequence {
  ArrowColor #343A40
  LifeLineBorderColor #495057
  ParticipantBackgroundColor #F8F9FA
  ParticipantBorderColor #343A40
  ActorBackgroundColor #F8F9FA
  ActorBorderColor #343A40
  GroupBorderColor #495057
}

actor "Operario de Bodega" as OP
participant ":SnapSip" as SS
participant "Servicio de almacenamiento\nde evidencias" as ALM <<sistema externo>>


OP -> SS : asignar pieza a torre con evidencia(pieza, torre, evidencia fotográfica)

alt torre Cerrada
  SS --> OP : rechazo: se sugiere registrar otra torre para la parte
else sin evidencia fotográfica
  SS --> OP : rechazo: se exige evidencia fotográfica
else pieza Enviado
  SS --> OP : rechazo: una pieza enviada no puede reasignarse
else torre de otra parte de la casa
  SS --> OP : rechazo: la torre no corresponde a la parte de la pieza

else torre Abierta de la misma parte y evidencia adjunta
  opt pieza Listo en otra torre
    SS --> OP : solicitud de confirmación de reemplazo
    OP -> SS : confirmar reemplazo
  end
  SS -> ALM : almacenar evidencia(fotografía)
  alt evidencia almacenada
    ALM --> SS : referencia de evidencia
    SS --> OP : pieza Listo, asignación registrada (usuario, fecha, hora y cupos disponibles)
opt torre alcanzó su capacidad máxima
   SS --> OP : Torre cerrada automáticamente, sin cupos
   end
  else falla del servicio
    ALM --> SS : error de almacenamiento
    SS --> OP : rechazo: asignación no registrada, la pieza no cambia de estado
  end
end
@enduml