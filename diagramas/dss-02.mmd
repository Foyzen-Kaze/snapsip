---
config:
  theme: neutral
  themeVariables:
    actorBorder: "#333333"
    actorBkg: "#f4f4f4"
    actorLineColor: "#555555"
    signalColor: "#222222"
    signalTextColor: "#222222"
    labelBoxBorderColor: "#555555"
    labelBoxBkgColor: "#eeeeee"
    loopTextColor: "#222222"
    noteBkgColor: "#fff8dc"
    noteBorderColor: "#999999"
    noteTextColor: "#222222"
  themeCSS: ".loopText, .loopText tspan, .messageText, .labelText { paint-order: stroke !important; stroke: #ffffff !important; stroke-width: 6px !important; stroke-linejoin: round; }"
  sequence:
    width: 260
    actorMargin: 70
---
sequenceDiagram
    actor ED as Encargado de Despacho
    participant SS as :SnapSip
    participant ALM as «sistema externo»<br/>Servicio de almacenamiento<br/>de evidencias

    ED->>SS: generar guía de despacho(proyecto, alcance)
    alt alcance incompleto o con torres Abiertas
        SS-->>ED: rechazo: piezas faltantes y torres sin cerrar
    else alcance completo y torres Cerradas
        SS-->>ED: guía de despacho Vigente en PDF (proyecto, alcance, piezas, torres)
        Note over ED,SS: carga física del camión
        ED->>SS: registrar envío(guía de despacho, evidencia fotográfica)
        alt guía Invalidada por desasignación (RD-01)
            SS-->>ED: rechazo: la guía fue invalidada, se debe generar una nueva
        else sin evidencia fotográfica
            SS-->>ED: rechazo: se exige evidencia fotográfica
        else guía Vigente con evidencia
            SS->>ALM: almacenar evidencia(fotografía)
            ALM-->>SS: referencia de evidencia
            SS-->>ED: envío registrado: guía Enviada y piezas Enviado (usuario, fecha y hora)
        end
    end